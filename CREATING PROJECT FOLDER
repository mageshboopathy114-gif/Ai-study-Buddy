Creating Folder Using Python

import os

folders = [
    "AI-StudyBuddy/model",
    "AI-StudyBuddy/view",
    "AI-StudyBuddy/controller",
    "AI-StudyBuddy/templates",
    "AI-StudyBuddy/static/css",
    "AI-StudyBuddy/static/js",
    "AI-StudyBuddy/database"
]

for folder in folders:
    os.makedirs(folder, exist_ok=True)

print("AI StudyBuddy project folders created successfully!")

Terminal Command

mkdir AI-StudyBuddy
cd AI-StudyBuddy

mkdir model view controller templates database
